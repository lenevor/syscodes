{
	"name": "syscodes/validation",
	"description": "The Syscodes Validation package.",
	"keywords": ["lenevor","validation"],
	"license": "BSD-3-Clause",
	"homepage": "https://lenevor.com",
	"support": {
		"issues": "https://github.com/lenevor/syscodes/issues",
        "source": "https://github.com/lenevor/syscodes"
	},
	"authors": [
		{
			"name": "Alexander Campo",
			"email": "jalexcam@gmail.com"
		}
	],
	"require": {
		"php": "^8.3",
		"ext-filter": "*",
        "ext-mbstring": "*",
		"egulias/email-validator": "^4.0",
		"symfony/http-foundation": "^7.4.0 || ^8.0.0",		
		"syscodes/support": "^0.9.1", 
		"syscodes/collections": "^0.9.1",
		"syscodes/translation": "^0.9.1",
		"syscodes/contracts": "^0.9.1"
	},
	"autoload": {
		"psr-4": {
			"Syscodes\\Components\\Validation\\": ""
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "0.9.x-dev"
        }
    },
	"suggest": {
		"syscodes/database": "Required to use the database presence verifier (^0.9.1).",
		"ramsey/uuid": "Required to use Validator::validateUuid() (^4.7)."
	},
	"config": {
        "sort-packages": true
    },
	"minimum-stability": "dev"
}