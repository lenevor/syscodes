{
	"name": "syscodes/support",
	"description": "The Syscodes Support package.",
	"keywords": ["lenevor","support"],
	"license": "BSD-3-Clause",
	"homepage": "https://lenevor.com",
	"support": {
		"issues": "https://github.com/lenevor/syscodes/issues",
        "source": "https://github.com/lenevor/syscodes"
	},
	"authors": [
		{
			"name": "Alexander Campo",
			"email": "jalexcam@gmail.com"
		}
	],
	"require": {
		"php": "^8.3",
		"ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
		"syscodes/contracts": "^0.9.1",
		"syscodes/core": "^0.9.1",
		"syscodes/http": "^0.9.1",
		"syscodes/version": "^0.9.1"
	},
	"suggest": {
        "ramsey/uuid": "Required to use Str::uuid() (^4.7).",
        "symfony/uid": "Required to use Str::ulid() (^7.4 || ^8.0).",
        "symfony/var-dumper": "Required to use the dd function (^7.4 || ^8.0)."
    },
	"autoload": {
		"psr-4": {
			"Syscodes\\Components\\Support\\": ""
		},
		"files": [
			"functions.php",
			"helpers.php"
		]
	},
	"extra": {
		"branch-alias": {
			"dev-master": "0.9.x-dev"
        }
    },
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "dev"
}