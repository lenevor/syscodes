{
	"name": "syscodes/support",
	"description": "The Syscodes Support package.",
	"keywords": ["lenevor","support"],
	"license": "BSD-3-Clause",
	"homepage": "https://lenevor.com",
	"support": {
		"issues": "https://github.com/lenevor/syscodes/issues",
        "source": "https://github.com/lenevor/syscodes"
	},
	"authors": [
		{
			"name": "Alexander Campo",
			"email": "jalexcam@gmail.com"
		}
	],
	"require": {
		"php": "^8.3",
		"ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
		"ramsey/uuid": "^4.7",
		"symfony/uid": "^7.4.0 || ^8.0.0",
		"syscodes/contracts": "^0.9.0",
		"syscodes/core": "^0.9.0",
		"syscodes/http": "^0.9.0",
		"syscodes/version": "^0.9.0"
	},
	"autoload": {
		"psr-4": {
			"Syscodes\\Components\\Support\\": ""
		},
		"files": [
			"functions.php",
			"helpers.php"
		]
	},
	"extra": {
		"branch-alias": {
			"dev-master": "0.9.x-dev"
        }
    },
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "dev"
}