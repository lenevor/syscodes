{
	"name": "syscodes/cache",
	"description": "The Syscodes Cache package.",
	"keywords": ["lenevor","cache"],
	"license": "BSD-3-Clause",
	"homepage": "https://lenevor.com",
	"support": {
		"issues": "https://github.com/lenevor/syscodes/issues",
        "source": "https://github.com/lenevor/syscodes"
	},
	"authors": [
		{
			"name": "Alexander Campo",
			"email": "jalexcam@gmail.com"
		}
	],
	"require": {
		"php": "^8.3",
		"psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
		"syscodes/contracts": "^0.9.1",
		"syscodes/core": "^0.9.1",
		"syscodes/macroable": "^0.9.1",
		"syscodes/support": "^0.9.1"
	},
	"provide": {
        "psr/simple-cache-implementation": "1.0 || 2.0 || 3.0"
    },
    "suggest": {
        "ext-apcu": "Required to use the APC cache driver.",
        "ext-memcached": "Required to use the memcache cache driver.",
        "syscodes/database": "Required to use the database cache driver (^0.9.1).",
        "syscodes/filesystem": "Required to use the file cache driver (^0.9.1).",
        "syscodes/redis": "Required to use the redis cache driver (^0.9.1)."
    },
	"autoload": {
		"psr-4": {
			"Syscodes\\Components\\Cache\\": ""
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "0.9.x-dev"
        }
    },
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "dev"
}