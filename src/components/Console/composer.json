{
	"name": "syscodes/console",
	"description": "The Syscodes Console package.",
	"keywords": ["lenevor","console"],
	"license": "BSD-3-Clause",
	"homepage": "https://lenevor.com",
	"support": {
		"issues": "https://github.com/lenevor/syscodes/issues",
        "source": "https://github.com/lenevor/syscodes"
	},
	"authors": [
		{
			"name": "Alexander Campo",
			"email": "jalexcam@gmail.com"
		}
	],
	"require": {
		"php": "^8.3",
		"ext-mbstring": "*",
		"nunomaduro/termwind": "^2.0",
		"psr/container": "^1.1.1|^2.0.2",
		"symfony/console": "^7.4.0 || ^8.0.0",
		"syscodes/contracts": "^0.9.2",
		"syscodes/core": "^0.9.2",
		"syscodes/macroable": "^0.9.2",
		"syscodes/support": "^0.9.2",
		"syscodes/version": "^0.9.2",
		"syscodes/view": "^0.9.2"
	},
	"suggest": {
        "syscodes/container": "Required to use the scheduler (^0.9.2).",
        "syscodes/filesystem": "Required to use the generator command (^0.9.2)."
    },
	"autoload": {
		"psr-4": {
			"Syscodes\\Components\\Console\\": ""
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "0.9.x-dev"
        }
    },
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "dev"
}