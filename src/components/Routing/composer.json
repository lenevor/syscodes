{
	"name": "syscodes/routing",
	"description": "The Syscodes Routing package.",
	"keywords": ["lenevor","routing"],
	"license": "BSD-3-Clause",
	"homepage": "https://lenevor.com",
	"support": {
		"issues": "https://github.com/lenevor/syscodes/issues",
        "source": "https://github.com/lenevor/syscodes"
	},
	"authors": [
		{
			"name": "Alexander Campo",
			"email": "jalexcam@gmail.com"
		}
	],
	"require": {
		"php": "^8.3",
		"ext-filter": "*",
        "ext-hash": "*",
		"symfony/console": "^7.4.0 || ^8.0.0",
		"symfony/http-foundation": "^7.4.0 || ^8.0.0",
		"symfony/routing": "^7.4.0 || ^8.0.0",
		"syscodes/container": "^0.9.1",
		"syscodes/contracts": "^0.9.1",
		"syscodes/controller": "^0.9.1",
		"syscodes/core": "^0.9.1",
		"syscodes/http": "^0.9.1",
		"syscodes/macroable": "^0.9.1",
		"syscodes/pipeline": "^0.9.1",
		"syscodes/support": "^0.9.1"
	},
	"suggest": {
        "syscodes/console": "Required to use the make commands (^0.9.1)."
    },
	"autoload": {
		"psr-4": {
			"Syscodes\\Components\\Routing\\": ""
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "0.9.x-dev"
        }
    },
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "dev"
}